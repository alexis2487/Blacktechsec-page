# ==========================================
# BLACKTECHSEC - CONFIGURACIÓN DE ENTORNO
# ==========================================

# URL pública del proyecto Supabase
# Ejemplo: https://tu-proyecto.supabase.co
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública (anon key) de Supabase
# Se obtiene en: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon / public
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# URL pública del Cloudflare Worker para subida a Cloudflare R2
# Ejemplo: https://tu-worker.workers.dev
VITE_STORAGE_WORKER_URL=https://tu-worker.workers.dev

# NOTA DE SEGURIDAD:
# NUNCA agregues claves privadas (service_role key, secretos de API, credenciales de R2 o contraseñas)
# en este archivo ni en el repositorio de Git. El cliente frontend únicamente consume endpoints públicos.

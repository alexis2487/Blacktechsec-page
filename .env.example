# ==========================================
# BLACKTECHSEC V2 - CONFIGURACIÓN DE ENTORNO
# ==========================================

# URL pública del proyecto Supabase
# Ejemplo: https://rqawfhijrokvefzaaxof.supabase.co
VITE_SUPABASE_URL=https://rqawfhijrokvefzaaxof.supabase.co

# Clave anónima pública (anon key) de Supabase
# Se obtiene en: Project Settings -> API -> Project API keys -> anon / public
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# NOTA DE SEGURIDAD:
# NUNCA agregues la service_role key, secretos o contraseñas en este archivo ni en el repositorio.
# El frontend únicamente requiere VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY.
